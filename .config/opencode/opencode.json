{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.4-mini",
  "autoupdate": false,
  "permission": {
    "external_directory": {
      "/nix/store/**": "allow",
      "/etc/nix/inputs/**": "allow",
      "~/.local/share/doomemacs/straight/repos/**": "allow",
    }
  },
  "provider": {
    "localhost": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Localhost",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "gemma-4-E4B": {
          "name": "gemma-4-E4B"
        }
      }
    },
    "chungus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Chungus",
      "options": {
        "baseURL": "https://llama.local.doreto.com.br/v1"
      },
      "models": {
        "qwen3.8-27b-quality": {
          "name": "Qwen3.8 Quality",
          "limit": {
            "context": 65536,
            "output": 65536,
          }
        },
        "qwen3.8-27b-quality-full": {
          "name": "Qwen3.8 Quality Full",
          "limit": {
            "context": 262144,
            "output": 262144,
          }
        },
        "qwen3.8-27b-coding": {
          "name": "Qwen3.8 Coding",
          "limit": {
            "context": 262144,
            "output": 262144,
          }
        }
      }
    }
  },
}
