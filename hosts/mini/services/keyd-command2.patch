diff --git a/docs/keyd.scdoc b/docs/keyd.scdoc
index d48439a..5d3cd3d 100644
--- a/docs/keyd.scdoc
+++ b/docs/keyd.scdoc
@@ -790,0 +791,13 @@ use this feature judiciously.
+*command2(<timeout>, <repeat timeout>, <shell command>)*
+	Execute the given shell command and repeat it while the bound key remains held.
+	The first repetition occurs after <timeout> milliseconds, with subsequent
+	repetitions occurring every <repeat timeout> milliseconds. Repetition stops
+	when the bound key is released or another key event occurs.
+
+	E.g.
+
+	command2(400, 200, brightness up)
+
+*NOTE:* Each repetition starts a new detached process. The configured interval
+should be long enough for the command to finish before its next invocation.
+
diff --git a/src/config.c b/src/config.c
index 3557fb0..d967bf6 100644
--- a/src/config.c
+++ b/src/config.c
@@ -77,0 +78 @@ static struct {
+		ARG_COMMAND,
@@ -101,0 +103 @@ static struct {
+	{ "command2", 	NULL,	OP_COMMAND2,	{ ARG_TIMEOUT, ARG_TIMEOUT, ARG_COMMAND } },
@@ -798,0 +801,17 @@ static int parse_descriptor(char *s,
+						break;
+					case ARG_COMMAND:
+						if (strlen(argstr) >= sizeof(config->commands[0].cmd)) {
+							err("max command length (%ld) exceeded\n", sizeof(config->commands[0].cmd) - 1);
+							return -1;
+						}
+
+						if (config->nr_commands >= ARRAY_SIZE(config->commands)) {
+							err("max commands (%d), exceeded", ARRAY_SIZE(config->commands));
+							return -1;
+						}
+
+						arg->idx = config->nr_commands;
+						strcpy(config->commands[config->nr_commands].cmd, argstr);
+						str_escape(config->commands[config->nr_commands].cmd);
+						config->nr_commands++;
+
